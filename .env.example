# MongoDB 8.0+ connection string (Atlas or self-hosted). The database name in the URL is used.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/shear_chemistry"

# Random string, at least 32 characters, used to sign admin sessions: openssl rand -hex 32
AUTH_SECRET=""

# Public URL of the site, used for SEO (canonical URLs, sitemap, social images)
SITE_URL="https://www.shearchemistrysuites.com"

# First admin account, created by `pnpm seed`
ADMIN_EMAIL="owner@example.com"
ADMIN_NAME="Site Owner"
ADMIN_PASSWORD=""

# Outgoing email for the waitlist welcome email and tour confirmations (optional; without it emails are logged and skipped)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="hello@shearchemistrysuites.com"
